<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/danger_scrim"
    android:clickable="true">

    <LinearLayout
        android:id="@+id/danger_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:layout_marginTop="72dp"
        android:background="@drawable/danger_sheet_background"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/danger_drag_area"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="10dp">

            <View
                android:layout_width="44dp"
                android:layout_height="5dp"
                android:background="@drawable/danger_drag_handle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/danger_dev_title"
                android:textColor="@color/danger_text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/danger_experiment_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/danger_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/danger_force_all"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/danger_force_background"
                android:gravity="center_vertical"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:text="@string/danger_force_all_server"
                android:textColor="@color/danger_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Space android:layout_width="8dp" android:layout_height="1dp" />

            <TextView
                android:id="@+id/danger_reset"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/danger_force_background"
                android:gravity="center"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="@string/danger_reset"
                android:textColor="@color/danger_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <EditText
            android:id="@+id/danger_search"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/danger_search_background"
            android:hint="@string/danger_search_hint"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:singleLine="true"
            android:textColor="@color/danger_text_primary"
            android:textColorHint="@color/danger_text_secondary"
            android:textSize="16sp" />

        <ListView
            android:id="@+id/danger_experiment_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="6dp"
            android:paddingBottom="24dp"
            android:scrollbars="none" />
    </LinearLayout>
</FrameLayout>
